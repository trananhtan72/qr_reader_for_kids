{
  "name": "whats-this",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run validate && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate-items.ts",
    "icons": "tsx scripts/make-icons.ts",
    "media": "tsx scripts/link-media.ts && npm run validate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  }
}
